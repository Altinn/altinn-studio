<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    This targets file is included in the Altinn.App.Api NuGet package and
    exposes the bundled app frontend as static files in consuming apps.
   -->
  <ItemGroup Condition="'$(IsAltinnApp)' == 'true'">
    <AltinnAppFrontendAsset Include="$(MSBuildThisFileDirectory)Altinn.App.Api/altinn-app-frontend/**/*" />
    <StaticWebAsset Include="@(AltinnAppFrontendAsset)">
      <SourceType>Package</SourceType>
      <SourceId>Altinn.App.Api</SourceId>
      <ContentRoot>$(MSBuildThisFileDirectory)Altinn.App.Api/</ContentRoot>
      <BasePath>/</BasePath>
      <RelativePath>altinn-app-frontend/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
      <AssetKind>All</AssetKind>
      <AssetMode>All</AssetMode>
      <AssetRole>Primary</AssetRole>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <OriginalItemSpec>%(FullPath)</OriginalItemSpec>
    </StaticWebAsset>

  <!--
    The Web SDK only copies *.json and *.config files to the build and publish output by default.
    The XSD schemas in models/ are read at runtime by the XSD validator (AppSettings:XsdValidation),
    so they must be copied too, or the validator finds no schema in a published (Docker) app.
   -->
    <Content Include="models/**/*.xsd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Remove="models/**/*.xsd" />
  </ItemGroup>

  <!--
    Altinn.Codelists and Altinn.FileAnalyzers implement Altinn.App.Core interfaces, so a release built for version 8
    of the app libraries stops the app at startup with a TypeLoadException. Restore lets it through, since those
    releases accept any Altinn.App.Core from 8.0.0 up. The check reads the resolved packages, so it also catches a
    release the app gets through another project or through central package management.
   -->
  <Target Name="AltinnCheckCodelistsAndFileAnalyzersVersions" AfterTargets="ResolvePackageAssets" Condition="'$(IsAltinnApp)' == 'true'">
    <ItemGroup>
      <_AltinnV8OnlyPackage Include="%(ResolvedCompileFileDefinitions.NuGetPackageId)"
                            Version="%(ResolvedCompileFileDefinitions.NuGetPackageVersion)"
                            Condition="('%(ResolvedCompileFileDefinitions.NuGetPackageId)' == 'Altinn.Codelists' or '%(ResolvedCompileFileDefinitions.NuGetPackageId)' == 'Altinn.FileAnalyzers') and $([MSBuild]::VersionLessThan('%(ResolvedCompileFileDefinitions.NuGetPackageVersion)', '9.0'))" />
    </ItemGroup>
    <Error Condition="'@(_AltinnV8OnlyPackage)' != ''"
           Code="ALTINNAPP0605"
           Text="%(_AltinnV8OnlyPackage.Identity) %(_AltinnV8OnlyPackage.Version) is built for version 8 of the Altinn app libraries, and the app fails at startup with version 9. Use the latest 9.x release of %(_AltinnV8OnlyPackage.Identity). studioctl app upgrade v9 makes this change." />
  </Target>
</Project>
