{
    "$schema": "https://altinncdn.no/toolkits/altinn-app-frontend/4/schemas/json/calculation/calculation.schema.v1.json",
    "calculations": [
        {
            "field": "skjema.calculated-fixed-value",
            "expression": ["concat", "Hello ", ["dataModel", "skjema.name"]]
        },
        {
            "field": "skjema.children[].total",
            "expression": ["multiply", ["dataModel", "skjema.children.price"], ["dataModel", "skjema.children.quantity"]]
        }
    ]
}
