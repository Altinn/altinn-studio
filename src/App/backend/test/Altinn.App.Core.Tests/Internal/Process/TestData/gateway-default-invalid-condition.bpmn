<?xml version="1.0" encoding="UTF-8"?>
<!-- The gateway's default flow has no condition, and the gateway takes it when no other flow's condition holds. -->
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:altinn="http://altinn.no/process"
                  id="Definitions_GatewayDefaultFallback" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_GatewayDefaultFallback" isExecutable="false">
    <bpmn:startEvent id="StartEvent">
      <bpmn:outgoing>Flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow1" sourceRef="StartEvent" targetRef="Task1"/>
    <bpmn:task id="Task1">
      <bpmn:incoming>Flow1</bpmn:incoming>
      <bpmn:outgoing>Flow2</bpmn:outgoing>
      <bpmn:extensionElements>
        <altinn:taskExtension>
          <altinn:taskType>data</altinn:taskType>
        </altinn:taskExtension>
      </bpmn:extensionElements>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow2" sourceRef="Task1" targetRef="Gateway1"/>
    <bpmn:exclusiveGateway id="Gateway1" default="Flow3">
      <bpmn:incoming>Flow2</bpmn:incoming>
      <bpmn:outgoing>Flow3</bpmn:outgoing>
      <bpmn:outgoing>Flow4</bpmn:outgoing>
      <bpmn:outgoing>Flow5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow3" sourceRef="Gateway1" targetRef="EndEvent">
      <bpmn:conditionExpression>not valid JSON: evaluating this must fail</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow4" sourceRef="Gateway1" targetRef="Task2">
      <bpmn:conditionExpression>["or", ["equals", ["gatewayAction"], "reject"], ["equals", ["gatewayAction"], "both"]]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow5" sourceRef="Gateway1" targetRef="Task2">
      <bpmn:conditionExpression>["equals", ["gatewayAction"], "both"]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:task id="Task2">
      <bpmn:incoming>Flow4</bpmn:incoming>
      <bpmn:incoming>Flow5</bpmn:incoming>
      <bpmn:outgoing>Flow6</bpmn:outgoing>
      <bpmn:extensionElements>
        <altinn:taskExtension>
          <altinn:taskType>data</altinn:taskType>
        </altinn:taskExtension>
      </bpmn:extensionElements>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow6" sourceRef="Task2" targetRef="EndEvent"/>
    <bpmn:endEvent id="EndEvent">
      <bpmn:incoming>Flow3</bpmn:incoming>
      <bpmn:incoming>Flow6</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
