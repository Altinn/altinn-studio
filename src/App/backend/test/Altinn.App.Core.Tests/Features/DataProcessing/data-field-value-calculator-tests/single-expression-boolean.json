{
    "name": "Should set boolean value to field with supported data type",
    "expects": [
        {
            "field": "form.nameResultBoolean",
            "result": true
        },
        {
            "field": "form.emailResultBoolean",
            "result": false
        }
    ],
    "calculationConfig": {
        "$schema": "https://altinncdn.no/toolkits/altinn-app-frontend/4/schemas/json/calculation/calculation.schema.v1.json",
        "calculations": [
            {
                "field": "form.nameResultBoolean",
                "expression": [
                    "equals",
                    [
                        "dataModel",
                        "form.name"
                    ],
                    "none"
                ]
            },
            {
                "field": "form.emailResultBoolean",
                "expression": [
                    "equals",
                    [
                        "dataModel",
                        "form.email"
                    ],
                    "none"
                ]
            }
        ]
    },
    "formData": {
        "form": {
            "name": "none",
            "email": "email@address.com",
            "nameResultBoolean": false,
            "emailResultBoolean": true
        }
    },
    "layouts": {
        "Page": {
            "$schema": "https://altinncdn.no/toolkits/altinn-app-frontend/4/schemas/json/layout/layout.schema.v1.json",
            "data": {
                "layout": [
                    {
                        "id": "name-input",
                        "type": "Input",
                        "dataModelBindings": {
                            "simpleBinding": "form.name"
                        }
                    },
                    {
                        "id": "email-input",
                        "type": "Input",
                        "dataModelBindings": {
                            "simpleBinding": "form.email"
                        }
                    }
                ]
            }
        }
    }
}
