{
    "name": "Should set the properties an object result contains, keep the others, and clear a property set to null",
    "expects": [
        {
            "field": "form.address",
            "result": {
                "street": "Main street 1234",
                "zip": 1234,
                "country": "NO",
                "note": null
            }
        },
        {
            "field": "form.address.street",
            "result": "Main street 1234"
        },
        {
            "field": "form.address.note",
            "result": null
        }
    ],
    "calculationConfig": {
        "$schema": "https://altinncdn.no/toolkits/altinn-app-frontend/4/schemas/json/calculation/calculation.schema.v1.json",
        "calculations": [
            {
                "field": "form.address",
                "expression": [
                    "object",
                    "street",
                    [
                        "concat",
                        [
                            "dataModel",
                            "form.streetName"
                        ],
                        " ",
                        [
                            "dataModel",
                            "form.streetNumber"
                        ]
                    ],
                    "zip",
                    [
                        "dataModel",
                        "form.streetNumber"
                    ],
                    "note",
                    null
                ]
            }
        ]
    },
    "formData": {
        "form": {
            "streetName": "Main street",
            "streetNumber": 1234,
            "address": {
                "street": "old",
                "zip": 0,
                "country": "NO",
                "note": "remove me"
            }
        }
    },
    "layouts": {
        "Page": {
            "$schema": "https://altinncdn.no/toolkits/altinn-app-frontend/4/schemas/json/layout/layout.schema.v1.json",
            "data": {
                "layout": []
            }
        }
    }
}
