<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>

    <RootNamespace>Altinn.App.Core.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <NoWarn>$(NoWarn);CS1591;CS0618</NoWarn>
    <!--
      CS1591: Don't warn for missing XML doc
      CS0618: This is a test project, so we usually continue testing [Obsolete] apis
    -->
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"/>
    <PackageReference Include="Verify.Moq" />
    <PackageReference Include="Verify.Xunit"/>
    <PackageReference Include="FluentAssertions"/>
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="Moq"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="WireMock.Net"/>
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="PublicApiGenerator" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Altinn.App.Core/Altinn.App.Core.csproj" />
    <ProjectReference Include="../Altinn.App.Tests.Common/Altinn.App.Tests.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Altinn.App.Tests.Common" />
    <Using Include="Altinn.App.Tests.Common.Auth" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="secrets.json" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <!--
    The Noark 5 arkivmelding schema and the metadata catalogue it imports, embedded so
    ArkivmeldingTests can validate a serialized shipment against the real schema rather than against
    assertions we wrote ourselves. Test-only: this project is never packed, so these never reach the
    Altinn.App.Core package, and nothing reads them at runtime.

    Unmodified upstream copies, retrieved 2026-08-13 from Arkivverket's Noark 5 schemas as published
    by difi/felleslosninger:
      https://raw.githubusercontent.com/difi/felleslosninger/gh-pages/resources/arkivmelding/arkivmelding.xsd
      https://raw.githubusercontent.com/difi/felleslosninger/gh-pages/resources/arkivmelding/metadatakatalog.xsd
    Keep them byte-identical to upstream; a local edit would make the validation prove nothing. If the
    standard is revised, replace them wholesale and let the tests report what moved.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Eformidling/Models/Schema/arkivmelding.xsd" />
    <EmbeddedResource Include="Eformidling/Models/Schema/metadatakatalog.xsd" />
  </ItemGroup>

  <!--
    A Standard Business Document captured from a real shipment, carried over from the eFormidling
    client package's own test data. Pins the model against a payload we did not write.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Eformidling/Models/TestData/sbd.json" />
  </ItemGroup>

  <!--
    Workflow-engine wire-contract drift guard. The engine owns the contract; these two files are
    consumed (not copied) directly from the engine host's test project so there is a single source of
    truth in the monorepo. The shared describer is compiled in; the engine's committed contract
    description is embedded. Neither affects the shipped Altinn.App.Core NuGet package — this is a
    test project. See Internal/WorkflowEngine/ContractTests/AppWireContractTests.cs.
  -->
  <ItemGroup>
    <Compile Include="../../../../Runtime/workflow-engine-app/tests/WorkflowEngine.App.Tests/Contract/WireContract.cs" Link="Internal/WorkflowEngine/ContractTests/WireContract.cs" />
    <EmbeddedResource Include="../../../../Runtime/workflow-engine-app/tests/WorkflowEngine.App.Tests/Contract/wire-contract.verified.json" Link="Internal/WorkflowEngine/ContractTests/wire-contract.verified.json" />
  </ItemGroup>

</Project>
