{
    "$schema": "https://altinncdn.no/toolkits/altinn-app-frontend/4/schemas/json/layout/layout.schema.v1.json",
    "data": {
        "layout": [
            {
                "id": "hide-fields",
                "type": "Input",
                "dataModelBindings": {
                    "simpleBinding": "HideFields"
                }
            },
            {
                "id": "visible-range",
                "type": "Input",
                "dataModelBindings": {
                    "simpleBinding": "VisibleRange"
                }
            },
            {
                "id": "hidden-range",
                "type": "Input",
                "hidden": ["dataModel", "HideFields"],
                "dataModelBindings": {
                    "simpleBinding": "HiddenRange"
                }
            },
            {
                "id": "hidden-range-keep",
                "type": "Input",
                "hidden": ["dataModel", "HideFields"],
                "removeWhenHidden": false,
                "dataModelBindings": {
                    "simpleBinding": "HiddenRangeKeep"
                }
            },
            {
                "id": "hidden-required",
                "type": "Input",
                "hidden": ["dataModel", "HideFields"],
                "dataModelBindings": {
                    "simpleBinding": "HiddenRequired"
                }
            },
            {
                "id": "hidden-non-nullable-range",
                "type": "Input",
                "hidden": ["dataModel", "HideFields"],
                "dataModelBindings": {
                    "simpleBinding": "HiddenNonNullableRange"
                }
            },
            {
                "id": "group",
                "type": "RepeatingGroup",
                "hiddenRow": ["dataModel", "Group.HideRow"],
                "dataModelBindings": {
                    "group": "Group"
                },
                "children": ["group-row-range"]
            },
            {
                "id": "group-row-range",
                "type": "Input",
                "dataModelBindings": {
                    "simpleBinding": "Group.RowRange"
                }
            }
        ]
    }
}
