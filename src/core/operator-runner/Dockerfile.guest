# The guest image of the VMs that the operator runner starts. The image contains no secrets, because the VMs run app
# code.

# studioctl-server runs on .NET 10. It reads the projects of an app with the MSBuild of a .NET 10 SDK.
FROM mcr.microsoft.com/dotnet/sdk:10.0-noble@sha256:548d93f8a18a1acbe6cc127bc4f47281430d34a9e35c18afa80a8d6741c2adc3 AS sdk10

# v9 apps target .NET 11. v8 apps target .NET 8. The SDK downloads the targeting packs for .NET 8 from NuGet.
FROM mcr.microsoft.com/dotnet/sdk:11.0-resolute@sha256:65f3c7c6a25a239ab3e6719f2896147e7b68242ff2d8818dd70498bde6ef8bea

COPY --from=sdk10 /usr/share/dotnet/sdk /usr/share/dotnet/sdk
COPY --from=sdk10 /usr/share/dotnet/sdk-manifests /usr/share/dotnet/sdk-manifests
COPY --from=sdk10 /usr/share/dotnet/shared /usr/share/dotnet/shared

# The commands run as app-build, which is not root in the VM. This makes an escape from the VM more difficult.
RUN useradd --create-home --user-group --shell /bin/bash app-build \
    && install --directory --owner app-build --group app-build /job

# studioctl is the newest published release, and each publish deploys this image again. The installer compares the
# binaries with the checksums of the release. studioctl writes to its home folder, so app-build owns it.
RUN tag="$(git -c versionsort.suffix=-preview. ls-remote --tags --refs --sort=-v:refname \
        https://github.com/Altinn/altinn-studio.git 'refs/tags/studioctl/v*' | head -n 1 | cut -f 2)" \
    && curl -fsSL "https://github.com/Altinn/altinn-studio/releases/download/${tag#refs/tags/}/install.sh" \
        | STUDIOCTL_HOME=/opt/studioctl sh -s -- --version "${tag#refs/tags/}" --install-dir /usr/local/bin \
    && STUDIOCTL_HOME=/opt/studioctl studioctl version \
    && chown -R app-build:app-build /opt/studioctl

# NuGet checks revocation offline, because the network allowlist blocks the certificate revocation servers.
# The SDK does not read the release metadata for its vulnerability check, because the allowlist also blocks
# builds.dotnet.microsoft.com. DOTNET_SDK_VULNERABILITY_CHECK_DISABLE accepts only `true`, not `1`.
ENV STUDIOCTL_HOME=/opt/studioctl \
    STUDIOCTL_NO_UPDATE_CHECK=1 \
    NO_COLOR=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_GENERATE_ASPNET_CERTIFICATE=false \
    DOTNET_SKIP_WORKLOAD_INTEGRITY_CHECK=1 \
    DOTNET_SDK_VULNERABILITY_CHECK_DISABLE=true \
    NUGET_XMLDOC_MODE=skip \
    NUGET_CERT_REVOCATION_MODE=offline \
    MSBUILDDISABLENODEREUSE=1 \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_AUTHOR_NAME="Studio operator runner" \
    GIT_AUTHOR_EMAIL=operator-runner@altinn.studio \
    GIT_COMMITTER_NAME="Studio operator runner" \
    GIT_COMMITTER_EMAIL=operator-runner@altinn.studio

USER app-build
WORKDIR /job
