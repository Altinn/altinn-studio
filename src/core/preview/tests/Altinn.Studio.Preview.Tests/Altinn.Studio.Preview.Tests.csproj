<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Altinn.Studio.Preview.Tests</RootNamespace>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- What V9TemplateTests check preview against. -->
  <PropertyGroup>
    <AppTemplate>..\..\..\..\App\template\v9\src\</AppTemplate>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(AppTemplate)**" Exclude="$(AppTemplate)**\bin\**;$(AppTemplate)**\obj\**" LinkBase="AppTemplate" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\App\backend\test\Altinn.App.Api.Tests\OpenApi\OpenApiSpecChangeDetection.SaveJsonSwagger.verified.json" Link="AppApi\app-api.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Like the service, which opens files with Linux system calls. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Altinn.Studio.Preview\Altinn.Studio.Preview.csproj" />
  </ItemGroup>

</Project>
