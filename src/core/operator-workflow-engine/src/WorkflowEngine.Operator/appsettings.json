{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "WorkflowEngine.Data.Services": "Information",
      "WorkflowEngine.WarmUp": "Information"
    }
  },
  "AllowedHosts": "*",
  "EngineSettings": {
    "EnableDatabaseInstrumentation": true,
    "Concurrency": {
      "MaxWorkers": 100,
      "MaxDbOperations": 10
    },
    "DefaultStepCommandTimeout": "00:01:40",
    "MaxStepCommandTimeout": "02:00:00",
    "DefaultStepRetryStrategy": {
      "BackoffType": "exponential",
      "BaseInterval": "00:00:01",
      "MaxDelay": "00:05:00",
      "MaxDuration": "1.00:00:00",
      "NonRetryableHttpStatusCodes": [400, 401, 403, 404, 422]
    },
    "DatabaseCommandTimeout": "00:00:30",
    "DatabaseRetryStrategy": {
      "BackoffType": "exponential",
      "BaseInterval": "00:00:00.100",
      "MaxDelay": "00:02:00",
      "MaxDuration": "02:00:00"
    },
    "Retention": {
      "RetentionPeriod": "14.00:00:00"
    },
    "Throttling": {
      "Enabled": false
    }
  }
}
