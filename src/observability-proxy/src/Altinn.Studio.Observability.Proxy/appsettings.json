{
  "AllowedHosts": "*",
  "ObservabilityProxy": {
    "PathPrefix": "/internal/observability",
    "Downstreams": {
      "Otlp": {
        "Address": "http://otel-victoria-ingest:4318/"
      },
      "Traces": {
        "Address": "http://victoria-traces:10428/"
      },
      "Metrics": {
        "Address": "http://victoria-metrics:8428/"
      }
    },
    "Authentication": {
      "Tokens": []
    },
    "RateLimiting": {
      "PermitLimit": 10000,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  }
}
