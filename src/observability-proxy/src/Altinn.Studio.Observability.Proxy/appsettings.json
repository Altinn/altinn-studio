{
  "AllowedHosts": "*",
  "ObservabilityProxy": {
    "PathPrefix": "/internal/observability",
    "Downstreams": {
      "Agents": {
        "Traces": "http://vtagent-traces:10429",
        "Metrics": "http://vmagent-metrics:8429",
        "Logs": "http://vlagent-logs:9429"
      },
      "Storage": {
        "Traces": ["http://vtsingle-traces-a:10428", "http://vtsingle-traces-b:10428"],
        "Metrics": ["http://vmsingle-metrics-a:8428", "http://vmsingle-metrics-b:8428"],
        "Logs": ["http://vlsingle-logs-a:9428", "http://vlsingle-logs-b:9428"]
      }
    },
    "Authentication": {
      "TokensFilePath": "/etc/observability-proxy/auth-tokens.json",
      "TokensFileReloadSeconds": 30,
      "Tokens": []
    },
    "RateLimiting": {
      "PermitLimit": 10000,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  }
}
