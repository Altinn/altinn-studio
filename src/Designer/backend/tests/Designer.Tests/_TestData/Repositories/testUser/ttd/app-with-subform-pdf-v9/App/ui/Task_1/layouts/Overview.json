{
    "$schema": "https://altinncdn.no/toolkits/altinn-app-frontend/4/schemas/json/layout/layout.schema.v1.json",
    "data": {
        "layout": [
            {
                "id": "intro",
                "type": "Paragraph",
                "textResourceBindings": {
                    "title": "intro.title"
                }
            },
            {
                "id": "vehicles",
                "type": "Subform",
                "layoutSet": "vehicleSubform",
                "textResourceBindings": {
                    "title": "vehicles.title"
                },
                "tableColumns": [
                    {
                        "headerContent": "vehicles.registration",
                        "cellContent": {
                            "query": "registration"
                        }
                    }
                ]
            },
            {
                "id": "notes",
                "type": "Subform",
                "layoutSet": "notesSubform",
                "tableColumns": []
            }
        ]
    }
}
