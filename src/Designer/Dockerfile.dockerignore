# Designer's frontend build requires the repository-root Yarn workspace, so this is the deliberate
# exception to the src/ context convention. Keep the root context as a complete narrow allowlist.
**
!package.json
!yarn.lock
!.yarnrc.yml
!.yarn/releases/**
!.yarn/patches/**
!src/App/frontend/package.json
!src/App/template/v8/src
!src/App/template/v8/src/**
!src/App/template/v9/src
!src/App/template/v9/src/**
!src/common/ts
!src/common/ts/**
!src/common/dotnet/Altinn.Studio.Common
!src/common/dotnet/Altinn.Studio.Common/**
!src/common/dotnet/Altinn.Studio.Common.Telemetry
!src/common/dotnet/Altinn.Studio.Common.Telemetry/**
!src/cli/.editorconfig
!src/cli/Directory.Build.props
!src/cli/Directory.Packages.props
!src/cli/common/dotnet/.editorconfig
!src/cli/common/dotnet/Directory.Build.props
!src/cli/common/dotnet/Altinn.Studio.AppDist
!src/cli/common/dotnet/Altinn.Studio.AppDist/**
!src/Designer/backend/.config/**
!src/Designer/backend/.csharpierignore
!src/Designer/backend/.csharpierrc.yaml
!src/Designer/backend/.editorconfig
!src/Designer/backend/Directory.Build.props
!src/Designer/backend/Directory.Packages.props
!src/Designer/backend/global.json
!src/Designer/backend/PolicyAdmin/**
!src/Designer/backend/src/**
!src/Designer/development/azure-devops-mock/package.json
!src/Designer/frontend
!src/Designer/frontend/**
**/bin
**/obj
**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
