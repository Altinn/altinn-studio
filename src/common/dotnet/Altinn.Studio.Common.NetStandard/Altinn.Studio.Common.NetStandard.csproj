<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the domain model for netstandard2.0, as a Roslyn analyzer would, so that it stays free of APIs newer than
    that. Nothing runs it.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The netstandard2.0 reference assemblies have no nullable annotations, so flow analysis would only add noise. -->
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <!-- No central package management reaches this directory, so the versions are pinned here. -->
  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Altinn.Studio.Common/src/Domain/**/*.cs" LinkBase="Domain" />
  </ItemGroup>
</Project>
