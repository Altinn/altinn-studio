{
  "name": "Count the elements in a list from the data model",
  "dataModels": [
    {
      "dataElement": {
        "id": "00dd7417-5b4e-402a-bb73-007537071f1d",
        "dataType": "default"
      },
      "data": {
        "numberList": [1, 2],
        "objectList": [{ "a": 1 }, { "a": 2 }, { "a": 3 }],
        "emptyList": [],
        "nested": {
          "innerList": ["Lorem", "ipsum", "dolor", "sit"]
        }
      }
    }
  ],
  "testCases": [
    {
      "name": "Should count the elements in a list of numbers",
      "expression": ["count", ["dataModel", "numberList"]],
      "expects": 2
    },
    {
      "name": "Should count the elements in a list of objects",
      "expression": ["count", ["dataModel", "objectList"]],
      "expects": 3
    },
    {
      "name": "Should return 0 for an empty list",
      "expression": ["count", ["dataModel", "emptyList"]],
      "expects": 0
    },
    {
      "name": "Should count the elements in a nested list",
      "expression": ["count", ["dataModel", "nested.innerList"]],
      "expects": 4
    },
    {
      "name": "Should compare the number of elements to a number",
      "expression": ["equals", 3, ["count", ["dataModel", "objectList"]]],
      "expects": true
    }
  ]
}
