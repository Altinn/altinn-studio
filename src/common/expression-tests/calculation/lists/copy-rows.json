{
  "name": "Rows copied from another list keep the ids of the rows they are copied from",
  "calculations": [
    {
      "field": "copies",
      "expression": ["dataModel", "rows"]
    }
  ],
  "testCases": [
    {
      "name": "source rows set the same properties",
      "dataModel": {
        "rows": [
          {
            "altinnRowId": "a0000000-0000-4000-8000-000000000001",
            "decimal": 10,
            "text": "a"
          },
          {
            "altinnRowId": "a0000000-0000-4000-8000-000000000002",
            "decimal": 20,
            "text": "b"
          }
        ],
        "copies": [
          {
            "altinnRowId": "c0000000-0000-4000-8000-000000000001",
            "decimal": 0,
            "text": "old"
          }
        ]
      },
      "expects": {
        "rows": [
          {
            "altinnRowId": "a0000000-0000-4000-8000-000000000001",
            "decimal": 10,
            "text": "a"
          },
          {
            "altinnRowId": "a0000000-0000-4000-8000-000000000002",
            "decimal": 20,
            "text": "b"
          }
        ],
        "copies": [
          {
            "altinnRowId": "a0000000-0000-4000-8000-000000000001",
            "decimal": 10,
            "text": "a"
          },
          {
            "altinnRowId": "a0000000-0000-4000-8000-000000000002",
            "decimal": 20,
            "text": "b"
          }
        ]
      }
    },
    {
      "name": "a property the source rows leave out is kept",
      "comment": "The frontend source row has no text property, so the merge leaves the text of the target row alone. The backend reads the source rows from the C# model, where text is null, so the result row carries text: null and the merge clears the text of the target row.",
      "disabledBackend": true,
      "dataModel": {
        "rows": [
          {
            "altinnRowId": "a0000000-0000-4000-8000-000000000001",
            "decimal": 10
          }
        ],
        "copies": [
          {
            "altinnRowId": "c0000000-0000-4000-8000-000000000001",
            "decimal": 0,
            "text": "kept"
          }
        ]
      },
      "expects": {
        "rows": [
          {
            "altinnRowId": "a0000000-0000-4000-8000-000000000001",
            "decimal": 10
          }
        ],
        "copies": [
          {
            "altinnRowId": "a0000000-0000-4000-8000-000000000001",
            "decimal": 10,
            "text": "kept"
          }
        ]
      }
    },
    {
      "name": "a property the source rows set to null is cleared",
      "dataModel": {
        "rows": [
          {
            "altinnRowId": "a0000000-0000-4000-8000-000000000001",
            "decimal": 10,
            "text": null
          }
        ],
        "copies": [
          {
            "altinnRowId": "c0000000-0000-4000-8000-000000000001",
            "decimal": 0,
            "text": "old"
          }
        ]
      },
      "expects": {
        "rows": [
          {
            "altinnRowId": "a0000000-0000-4000-8000-000000000001",
            "decimal": 10,
            "text": null
          }
        ],
        "copies": [
          {
            "altinnRowId": "a0000000-0000-4000-8000-000000000001",
            "decimal": 10,
            "text": null
          }
        ]
      }
    }
  ]
}
