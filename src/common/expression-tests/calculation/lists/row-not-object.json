{
  "name": "A list of objects with a row that is not an object is logged and leaves the list as it is",
  "dataModel": {
    "rows": [
      {
        "altinnRowId": "a0000000-0000-4000-8000-000000000001",
        "decimal": 1
      }
    ]
  },
  "testCases": [
    {
      "name": "null row",
      "calculations": [
        {
          "field": "rows",
          "expression": ["list", ["object", "total", 1], null]
        }
      ],
      "expects": {
        "rows": [
          {
            "altinnRowId": "a0000000-0000-4000-8000-000000000001",
            "decimal": 1
          }
        ]
      },
      "expectsErrors": ["not an object"]
    },
    {
      "name": "number row",
      "calculations": [
        {
          "field": "rows",
          "expression": ["list", 3, ["object", "total", 1]]
        }
      ],
      "expects": {
        "rows": [
          {
            "altinnRowId": "a0000000-0000-4000-8000-000000000001",
            "decimal": 1
          }
        ]
      },
      "expectsErrors": ["not an object"]
    }
  ]
}
