{
  "name": "A list of primitives replaces the whole list",
  "dataModel": {
    "numbers": [1, 2, 3],
    "texts": ["x", "y"],
    "text": "c"
  },
  "testCases": [
    {
      "name": "strings",
      "calculations": [
        {
          "field": "texts",
          "expression": ["list", "a", "b", ["dataModel", "text"]]
        }
      ],
      "expects": {
        "numbers": [1, 2, 3],
        "texts": ["a", "b", "c"],
        "text": "c"
      }
    },
    {
      "name": "numbers",
      "calculations": [
        {
          "field": "numbers",
          "expression": ["list", 4, 5]
        }
      ],
      "expects": {
        "numbers": [4, 5],
        "texts": ["x", "y"],
        "text": "c"
      }
    },
    {
      "name": "strings into numbers",
      "calculations": [
        {
          "field": "numbers",
          "expression": ["list", "4", "5"]
        }
      ],
      "expects": {
        "numbers": [4, 5],
        "texts": ["x", "y"],
        "text": "c"
      }
    },
    {
      "name": "numbers into strings",
      "calculations": [
        {
          "field": "texts",
          "expression": ["list", 4, 5]
        }
      ],
      "expects": {
        "numbers": [1, 2, 3],
        "texts": ["4", "5"],
        "text": "c"
      }
    }
  ]
}
