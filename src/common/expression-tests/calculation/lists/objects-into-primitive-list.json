{
  "name": "A list of objects for a list of primitives is not written",
  "calculations": [
    {
      "field": "numbers",
      "expression": ["list", ["object", "v", 1], ["object", "v", 2]]
    }
  ],
  "testCases": [
    {
      "name": "numbers",
      "dataModel": {
        "numbers": [2, 3]
      },
      "expects": {
        "numbers": [2, 3]
      },
      "expectsWarnings": ["numbers"]
    },
    {
      "name": "an empty list",
      "dataModel": {
        "numbers": []
      },
      "expects": {
        "numbers": []
      },
      "expectsWarnings": ["numbers"]
    },
    {
      "name": "a list with a null item first",
      "dataModel": {
        "nullableNumbers": [null, 3]
      },
      "calculations": [
        {
          "field": "nullableNumbers",
          "expression": ["list", ["object", "v", 1]]
        }
      ],
      "expects": {
        "nullableNumbers": [null, 3]
      },
      "expectsWarnings": ["nullableNumbers"]
    }
  ]
}
