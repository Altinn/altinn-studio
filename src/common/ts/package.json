{
  "name": "@studio/common-typescript",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "yarn workspaces foreach -A --include '@app/*' --include '@studio/*' --exclude '@studio/common-typescript' run typecheck",
    "lint": "yarn workspaces foreach -A --include '@app/*' --include '@studio/*' --exclude '@studio/common-typescript' run lint",
    "format:check": "yarn workspaces foreach -A --include '@app/*' --include '@studio/*' --exclude '@studio/common-typescript' run format:check"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.1"
  }
}
