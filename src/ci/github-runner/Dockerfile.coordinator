FROM rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS build

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libcap-ng-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /source
COPY Cargo.toml Cargo.lock ./
COPY src/experimental src/experimental
COPY src/ci/github-runner/coordinator src/ci/github-runner/coordinator
RUN cargo build \
    --locked \
    --release \
    --manifest-path src/ci/github-runner/coordinator/Cargo.toml \
    && strip --strip-unneeded \
      /source/target/release/coordinator \
      /source/target/release/sandbox-image

FROM ubuntu:24.04@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea AS runtime-bundle

ARG MICROSANDBOX_RUNTIME_VERSION=0.6.9-digdir.3

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /runtime
RUN runtime_tag="digdir-v${MICROSANDBOX_RUNTIME_VERSION}" \
    && release_url="https://github.com/martinothamar/microsandbox/releases/download/${runtime_tag}" \
    && curl --fail --location --retry 5 --output microsandbox-linux-x86_64.tar.gz \
      "${release_url}/microsandbox-linux-x86_64.tar.gz" \
    && curl --fail --location --retry 5 --output checksums.sha256 \
      "${release_url}/checksums.sha256" \
    && sha256sum --check --ignore-missing --strict checksums.sha256 \
    && grep --fixed-strings --quiet '  microsandbox-linux-x86_64.tar.gz' checksums.sha256

# The downloaded Microsandbox runtime currently requires glibc 2.39.
FROM ubuntu:24.04@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates libcap-ng0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build \
  /source/target/release/coordinator \
  /usr/local/bin/coordinator
COPY --from=build \
  /source/target/release/sandbox-image \
  /usr/local/bin/sandbox-image
COPY --from=runtime-bundle \
  /runtime/microsandbox-linux-x86_64.tar.gz \
  /runtime/checksums.sha256 \
  /opt/altinn/microsandbox/

ENTRYPOINT ["/usr/local/bin/coordinator"]
