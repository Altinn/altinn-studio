load_module modules/ngx_otel_module.so;

worker_processes auto;

events {
  worker_connections 1024;
}

http {
  server_tokens off;

  proxy_buffer_size 128k;
  proxy_buffers 8 256k;
  proxy_busy_buffers_size 512k;
  large_client_header_buffers 64 16k;

  client_max_body_size 50M;

  otel_exporter {
    endpoint ${OTEL_ENDPOINT};
  }
  otel_service_name ${OTEL_SERVICE_NAME};
  otel_trace ${OTEL_TRACE};
  otel_trace_context propagate;
  # Span names default to the matched location, which for regex locations is the regex itself.
  # Name spans after the route instead, and keep them low cardinality: only the method, literal
  # prefixes and captures from fixed alternations, never the URI. Locations below set their own
  # name; anything else, including the extra servers, falls back to the method alone.
  # The name is evaluated when the span ends, after a rewrite may have replaced positional
  # captures such as $1, so locations use named captures.
  # nginx passes on any method a client sends, so methods outside the standard set are named
  # HTTP, as the OpenTelemetry semantic conventions do.
  map $request_method $span_method {
    GET     GET;
    HEAD    HEAD;
    POST    POST;
    PUT     PUT;
    DELETE  DELETE;
    PATCH   PATCH;
    OPTIONS OPTIONS;
    CONNECT CONNECT;
    TRACE   TRACE;
    default HTTP;
  }
  otel_span_name $span_method;

  # Designer names its responses' routes in X-Altinn-Route, the route template of the endpoint
  # that handled the request, such as /designer/api/{org}/{app}/validation. Spans for locations
  # proxied to Designer are named after it, as Designer's own span is. Where it's missing, such
  # as when Designer is down or no route matched, a location's fallback name, set in
  # $lb_designer_fallback_route, is used instead. The header comes from Designer only, never
  # from the client, and its values are a fixed set of route templates.
  map $upstream_http_x_altinn_route $lb_designer_route {
    ""      $lb_designer_fallback_route;
    default $upstream_http_x_altinn_route;
  }

  # Gitea has no tracing, so spans for /repos/ are named after the shape of the URL. The names
  # are a fixed set: never put owner or repository names in them. Regular expressions are checked
  # in order, so the fixed prefixes come before the owner and repository patterns they also match.
  map $uri $lb_repos_route {
    ~^/repos/api/v1/                         "/repos/api/v1/*";
    ~^/repos/assets/                         "/repos/assets/*";
    ~^/repos/avatars/                        "/repos/avatars/*";
    ~^/repos/repo-avatars/                   "/repos/repo-avatars/*";
    ~^/repos/[^/]+/[^/]+/info/refs$          "/repos/{owner}/{repo}/info/refs";
    ~^/repos/[^/]+/[^/]+/git-upload-pack$    "/repos/{owner}/{repo}/git-upload-pack";
    ~^/repos/[^/]+/[^/]+/git-receive-pack$   "/repos/{owner}/{repo}/git-receive-pack";
    ~^/repos/[^/]+/[^/]+/info/lfs/           "/repos/{owner}/{repo}/info/lfs/*";
    default                                  "/repos/*";
  }

  upstream designer {
    server ${DESIGNER_HOST};
  }

  upstream dashboard {
    server ${DASHBOARD_HOST};
  }

  upstream editor {
    server ${EDITOR_HOST};
  }

  upstream preview {
    server ${PREVIEW_HOST};
  }

  upstream admin {
    server ${ADMIN_HOST};
  }

  upstream resourceadm {
    server ${RESOURCEADM_HOST};
  }

  upstream info {
    server ${INFO_HOST};
  }

  upstream settings {
    server ${SETTINGS_HOST};
  }

  upstream repositories {
    server ${REPOS_HOST};
  }

  include /etc/nginx/extra-upstreams/*.conf;
  include /etc/nginx/logging/*.conf;

  map $uri $spa_path {
    ~^/(dashboard|editor|preview|admin|resourceadm|info|settings)(/.*)?$ $1;
    default                                               none;
  }

  map $spa_path $spa_upstream {
    dashboard     dashboard;
    editor        editor;
    preview       preview;
    admin         admin;
    resourceadm   resourceadm;
    info          info;
    settings      settings;
    default       designer;
  }

  map $spa_path $spa_rewrite {
    dashboard     1;
    editor        1;
    preview       1;
    admin         1;
    resourceadm   1;
    info          1;
    settings      1;
    default       0;
  }

  server {
    listen ${LISTEN_DIRECTIVE};
    server_name ${SERVER_NAME};

    include /etc/nginx/ssl/*.conf;

    proxy_cookie_path ~*^/.* /;
    proxy_redirect off;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Like proxy_set_header, proxy_hide_header is only inherited by a location that declares
    # none of its own, so a location that declares one must restate this.
    proxy_hide_header X-Altinn-Route;

    include /etc/nginx/error-pages/*.conf;

    location = / {
      set $lb_designer_fallback_route "/";
      otel_span_name "$span_method $lb_designer_route";
      proxy_pass http://designer/;
    }

    location ~ ^/(?<lb_route_prefix>designer|designerapi|login|logout|Home|ansattporten-signin-oidc|signin-oidc)/ {
      set $lb_designer_fallback_route "/$lb_route_prefix/*";
      otel_span_name "$span_method $lb_designer_route";
      proxy_pass http://designer;
    }

    location ^~ /hubs/ {
      # A SignalR hub connection stays open for as long as the client is connected, so it's not traced.
      # Designer traces each hub method call as its own root span. With tracing off, propagate would
      # still send an unsampled traceparent, and Designer would then drop its spans for negotiation.
      otel_trace off;
      otel_trace_context ignore;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "Upgrade";
      proxy_pass http://designer;
    }

    location /repos/ {
      otel_span_name "$span_method $lb_repos_route";
      proxy_pass http://repositories/;
      include /etc/nginx/error-pages/repos-error*.inc;
    }

    location ~ ^/(?<lb_spa_app>dashboard|editor|preview|admin|resourceadm|info|settings)/assets(/.*)?$ {
      otel_span_name "$span_method /$lb_spa_app/assets/*";
      proxy_pass http://$spa_upstream;
    }

    location ~ ^/(?<lb_spa_app>dashboard|editor|preview|admin|resourceadm|info|settings)(/.*)?$ {
      otel_span_name "$span_method /$lb_spa_app/*";
      if ($spa_rewrite) {
        rewrite ^/[^/]+(/.*)?$ /$spa_path/index.html break;
      }
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_pass http://$spa_upstream;
    }

    include /etc/nginx/extra-locations/*.conf;

    location / {
      set $lb_designer_fallback_route "/*";
      otel_span_name "$span_method $lb_designer_route";
      proxy_pass http://designer;
    }
  }

  include /etc/nginx/extra-servers/*.conf;
}
