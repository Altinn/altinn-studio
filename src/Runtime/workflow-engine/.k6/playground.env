# The observability playground's engine settings, for both ways to run it: `env_file:` in
# docker-compose.playground.yaml (its header says why they exist) and `make playground-host`.
# Compose reads this file and a POSIX shell sources it: keep to KEY=VALUE and whole-line comments.

# Export telemetry even when no OTLP endpoint is set, to the SDK's default http://localhost:4317: the
# collector on the host for `make playground-host`. OTEL_EXPORTER_OTLP_ENDPOINT, which the compose
# stack sets for its container, takes precedence.
EngineSettings__EnableTelemetry=true

# Namespace circuit breaker. OFF by default in every other configuration.
EngineSettings__Throttling__Enabled=true
# The two trip thresholds are deliberately left at their shipped defaults (50 requeued
# workflows, half the namespace's active population). `perpetual-mix.js` sizes its storm burst
# to clear them within a sweep or two, and sizes its ordinary failure arms to stay well under
# them, so the playground needs no help here — only the cadence and windows below.
# 10s rather than 30s: the sweep is what emits every throttle metric, so its cadence is the
# dashboard's sample rate for this family.
EngineSettings__Throttling__SweepInterval=00:00:10
EngineSettings__Throttling__CanaryCount=3
# 1 min rather than 10: the window is the floor on how long a tripped breaker stays tripped,
# so it is also the floor on how long the human waits to see a release cohort and a clear.
EngineSettings__Throttling__InitialWindow=00:01:00
EngineSettings__Throttling__MaxWindow=00:05:00
# The mailbox deadline sweep drives
# `altinn.workflow_engine.mailbox.closed{altinn.workflow_engine.reason="deadline"}` and
# `altinn.workflow_engine.mailbox.delivery.unpaired`. At the 5 min default a
# deliberately-abandoned mailbox takes 5 min to show up; at 20 s it takes 20.
EngineSettings__MailboxSweepInterval=00:00:20
