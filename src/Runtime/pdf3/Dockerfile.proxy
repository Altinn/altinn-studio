FROM --platform=$BUILDPLATFORM golang:1.26.5-trixie@sha256:f1a132429b98724a904e9b3bdbaed399d8f923203c3e5170e6def66d0a7cc04c AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /app

COPY go.mod go.sum ./

RUN go mod download

COPY . .

# The commit the image is built from, reported as service.version. "dev" in local builds.
ARG SERVICE_VERSION=dev
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -ldflags "-X altinn.studio/pdf3/internal/telemetry.serviceVersion=${SERVICE_VERSION}" \
    -o main ./cmd/proxy
# The relay ships in the proxy image; its Deployment runs ./relay
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -ldflags "-X altinn.studio/pdf3/internal/telemetry.serviceVersion=${SERVICE_VERSION}" \
    -o relay ./cmd/relay

FROM scratch

WORKDIR /app

COPY --from=builder /app/main .
COPY --from=builder /app/relay .

EXPOSE 5030
# The relay, when the image runs ./relay
EXPOSE 5032

COPY --from=builder /etc/passwd /etc/passwd
# The relay verifies DIS Edge's certificate against these, scratch has none
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
USER nobody

ENTRYPOINT ["./main"]
