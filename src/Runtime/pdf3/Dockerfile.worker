FROM --platform=$BUILDPLATFORM golang:1.27.3-trixie@sha256:fbb7ae40b62ff8afe31662df570d39b4f5052ac32b90dae8e60d7657a20a74f4 AS builder
ARG TARGETOS
ARG TARGETARCH

# The build context is src/: pdf3 builds against the shared Go module in common/go, which its
# go.mod replaces with that directory. Dockerfile.{proxy,worker}.dockerignore keep the context to
# the two modules.
WORKDIR /src/Runtime/pdf3

COPY common/go/go.mod common/go/go.sum /src/common/go/
COPY Runtime/pdf3/go.mod Runtime/pdf3/go.sum ./

RUN go mod download

COPY common/go/ /src/common/go/
COPY Runtime/pdf3/ ./

# The commit the image is built from, reported as service.version. "dev" in local builds.
ARG SERVICE_VERSION=dev
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -ldflags "-X altinn.studio/pdf3/internal/telemetry.serviceVersion=${SERVICE_VERSION}" \
    -o /app/main ./cmd/worker

FROM docker.io/chromedp/headless-shell:stable@sha256:3da74b0945e4f80f00f0310bcda9f76cee283539ebd200a053a7bebf3de89423

USER root

ENV DEBIAN_FRONTEND=noninteractive
RUN echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections && \
    sed -i 's/main$/main contrib/' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        fontconfig \
        ttf-mscorefonts-installer && \
    fc-cache -f -v && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && \
    apt-get install -y --no-install-recommends libnss3-tools && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/main .
COPY Runtime/pdf3/docker-entrypoint.sh .

RUN chmod +x ./docker-entrypoint.sh && \
    mkdir -p ./output

EXPOSE 5031

RUN mkdir -p /tmp/user-home && \
    chown -R nobody:nogroup /tmp/user-home

ENV HOME=/tmp/user-home
USER nobody

ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["./main"]
