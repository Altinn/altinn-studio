{
  // Environment-specific overrides for prod, layered on top of appsettings.json.
  //
  // The file name is the environment NAME, not an ASP.NET Core environment: this host takes
  // ASPNETCORE_ENVIRONMENT from the `runtime-environment` ConfigMap, so a running pod reports
  // "prod". An Altinn app is the opposite - it gets "Staging"/"Production" from apps-config -
  // so a file named appsettings.Staging.json would never be read here.
  //
  // Scaffolded ahead of the deployment: as of writing only the at23 and tt02 syncroots carry
  // a workflow-engine-app.yaml, so nothing syncs this service to prod yet.
  //
  // Deliberately empty: nothing differs for this environment yet. Shared settings belong in
  // appsettings.json; put only what genuinely varies here.
  "EngineSettings": {},
  "AppCommandSettings": {}
}
