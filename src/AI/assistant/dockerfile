# Built from the repo root so the image can bundle the v9 layout schemas from
# src/common. dockerfile.dockerignore limits the context to what the image needs.
FROM python:3.14.7-slim-bookworm@sha256:82bc3c539b8813ada9d68c63b40158fa002f7f33de9bf3312a3dfdc0620dff56

COPY --from=ghcr.io/astral-sh/uv:0.13.0@sha256:cdc6093146eb3ff6a40107b38f008b789e050e77ad87865e381d9917da55a168 /uv /usr/local/bin/uv

WORKDIR /app

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

RUN git config --system user.name "Altinity Agent" && \
    git config --system user.email "agent@altinn.studio"

# uv must use the Python of the base image. The build fails if it is not the version in .python-version.
ENV UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_CACHE=1 \
    PATH="/app/.venv/bin:$PATH"

COPY src/AI/assistant/pyproject.toml src/AI/assistant/uv.lock src/AI/assistant/.python-version ./

RUN uv sync --locked --no-dev --no-install-project --extra preview && \
    playwright install --with-deps chromium

COPY src/AI/assistant/agents/ ./agents/
COPY src/AI/assistant/api/ ./api/
COPY src/AI/assistant/services/ ./services/
COPY src/AI/assistant/shared/ ./shared/
# The v9 layout schemas, where BaseConfig.LAYOUT_SCHEMA_V9_DIR points from /app. The CDN
# serves only the v8 contract.
COPY src/common/ts/layout-contract/schemas/json/layout/ /common/ts/layout-contract/schemas/json/layout/

EXPOSE 8071

ENV PYTHONUNBUFFERED=1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8071"]
