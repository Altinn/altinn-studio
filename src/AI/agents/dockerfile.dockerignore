# The agents image builds from the repo root so it can also compile the bundled studioctl-server.
# Ignore everything, then include only what the image needs.
*

!src/AI/agents
!src/cli/Directory.Build.props
!src/cli/Directory.Packages.props
!src/cli/studioctl-server
!src/Runtime/common/dotnet/Altinn.Studio.Runtime.Common

# Heavy or irrelevant paths inside the included dirs.
**/bin
**/obj
**/.venv
**/.ci-venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/node_modules
