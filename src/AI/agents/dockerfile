# Python image with uv pre-installed
FROM ghcr.io/astral-sh/uv:0.9.7-python3.12-bookworm-slim@sha256:4f52717de41541452f5318571b05da783d2ddf346a94b4d5c6512a4b51e986bd

WORKDIR /app

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

RUN git config --system user.name "Altinity Agent" && \
    git config --system user.email "agent@altinn.studio"

COPY pyproject.toml uv.lock ./

RUN uv sync --locked --no-dev --no-install-project

COPY agents/ ./agents/
COPY api/ ./api/
COPY services/ ./services/
COPY shared/ ./shared/

EXPOSE 8071

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8071"]
