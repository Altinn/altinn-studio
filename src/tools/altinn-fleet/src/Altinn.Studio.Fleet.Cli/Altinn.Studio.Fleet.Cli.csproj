<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Altinn.Studio.Fleet.Cli</RootNamespace>
    <AssemblyName>fleet</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Altinn.Studio.Fleet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Altinn.Studio.Fleet/Altinn.Studio.Fleet.csproj" />
    <ProjectReference Include="../Altinn.Studio.Fleet.ApiUsage/Altinn.Studio.Fleet.ApiUsage.csproj" />
  </ItemGroup>

  <!-- MSBuild loads from the installed SDK at run time (see Altinn.Studio.Fleet.ApiUsage), so it is compile-only here too. -->
