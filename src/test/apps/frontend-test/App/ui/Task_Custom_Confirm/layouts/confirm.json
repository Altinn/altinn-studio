{
  "$schema": "https://altinn.studio/designer/app-dist/9.0.0-preview.6/schemas/json/layout/layout.schema.v1.json",
  "data": {
    "layout": [
      {
        "id": "confirmTitle",
        "type": "Heading",
        "textResourceBindings": {
          "title": "confirm.title"
        },
        "size": "L"
      },
      {
        "id": "confirmBody",
        "type": "Paragraph",
        "textResourceBindings": {
          "title": "customConfirm.body"
        }
      },
      {
        "id": "buttonGroup",
        "type": "ButtonGroup",
        "children": ["back", "sendInButton"]
      },
      {
        "id": "back",
        "type": "ActionButton",
        "action": "reject",
        "buttonStyle": "secondary",
        "textResourceBindings": {
          "title": "Gå tilbake"
        }
      },
      {
        "id": "sendInButton",
        "type": "ActionButton",
        "action": "confirm",
        "buttonStyle": "primary",
        "textResourceBindings": {
          "title": "confirm.button_text"
        }
      }
    ]
  }
}

