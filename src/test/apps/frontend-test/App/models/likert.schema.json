{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema.json",
  "@xsdRootElement": "melding",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/LikertSurvey"
    }
  ],
  "$defs": {
    "LikertSurvey": {
      "properties": {
        "Questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Question"
          }
        }
      },
      "required": [
        "Questions"
      ]
    },
    "Question": {
      "properties": {
        "Id": {
          "type": "string"
        },
        "Answer": {
          "type": "string"
        }
      },
      "required": [
        "Id",
        "Answer"
      ]
    }
  }
}
