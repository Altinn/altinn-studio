{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema.json",
  "@xsdRootElement": "melding",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/Datalist"
    }
  ],
  "$defs": {
    "Datalist": {
      "properties": {
        "SelectedItem": {
          "type": "string"
        },
        "SelectedItemProfession": {
          "type": "string"
        },
        "Search": {
          "type": "string"
        },
        "UseCustomConfirm": {
          "type": "boolean"
        }
      },
      "required": [
        "SelectedItem"
      ]
    }
  }
}
