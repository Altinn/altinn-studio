{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema.json",
  "@xsdRootElement": "melding",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/Datalist"
    }
  ],
  "$defs": {
    "Datalist": {
      "properties": {
        "SelectedItem": {
          "type": "string"
        },
        "SelectedItemProfession": {
          "type": "string"
        },
        "Search": {
          "type": "string"
        },
        "UseCustomConfirm": {
          "type": "boolean"
        },
        "SelectedPeople": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectedPerson"
          }
        }
      },
      "required": [
        "SelectedItem"
      ]
    },
    "SelectedPerson": {
      "properties": {
        "Name": {
          "type": "string"
        },
        "Age": {
          "type": "integer"
        },
        "Profession": {
          "type": "string"
        }
      }
    }
  }
}
