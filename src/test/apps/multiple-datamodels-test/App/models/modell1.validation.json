{
  "$schema": "https://altinn.studio/designer/app-dist/9.0.0-preview.6/schemas/json/validation/validation.schema.v1.json",
  "validations": {
    "tekstfelt": [
      {
        "message": "Feil er feil",
        "condition": ["equals", ["dataModel", ["argv", 0]], "feil"]
      }
    ],
    "bransje": [
      {
        "message": "Du kan ikke velge både IKT og Verkstedindustri",
        "condition": [
          "and",
          ["commaContains", ["dataModel", ["argv", 0]], "491"],
          ["commaContains", ["dataModel", ["argv", 0]], "445"]
        ]
      }
    ]
  },
  "definitions": {}
}
