        "value": "2026-07-20 18:00:00.000",
        "format": "dd.MM.yyyy",
        "grid": { "xs": 6 }
      },
      {
        "id": "DatePage-FormatDateTime",
        "type": "Date",
        "textResourceBindings": {
          "title": "dd.MM.yyyy HH:mm:ss"
        },
        "value": "2026-07-20 18:00:00.000",
        "format": "dd.MM.yyyy HH:mm:ss",
        "grid": { "xs": 6 }
      },
      {
        "id": "DatePage-FormatSlashes",
        "type": "Date",
        "textResourceBindings": {
          "title": "dd/MM/yyyy HH:mm:ss"
        },
        "value": "2026-07-20 18:00:00.000",
        "format": "dd/MM/yyyy HH:mm:ss",
        "grid": { "xs": 6 }
