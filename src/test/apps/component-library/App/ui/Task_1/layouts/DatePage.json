      {
        "id": "DatePage-H-InGrid",
        "type": "Heading",
        "size": "h3",
        "textResourceBindings": {
          "title": "Inne i en Grid-celle"
        }
      },
      {
        "id": "DatePage-InGrid-Info",
        "type": "Paragraph",
        "textResourceBindings": {
          "title": "Grid-celler viser komponentene uten ledetekst, slik at bare verdien (og eventuelt ikonet) vises."
        }
      },
      {
        "id": "DatePage-Grid",
        "type": "Grid",
        "rows": [
          {
            "header": true,
            "cells": [{ "text": "Oppsett" }, { "text": "Dato" }]
          },
          {
            "cells": [{ "text": "Tittel og ikon" }, { "component": "DatePage-InGrid-Icon" }]
          },
          {
            "cells": [
              { "text": "Tittel og beskrivelse" },
              { "component": "DatePage-InGrid-Description" }
            ]
          }
        ]
      },
      {
        "id": "DatePage-InGrid-Icon",
        "type": "Date",
        "textResourceBindings": {
          "title": "Registreringsdato"
        },
        "value": "2026-07-20",
        "format": "dd.MM.yyyy",
        "icon": "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PGNpcmNsZSBjeD0iMTIiIGN5PSIxMiIgcj0iMTEiIGZpbGw9IiNjMDM5MmIiLz48L3N2Zz4="
      },
      {
        "id": "DatePage-InGrid-Description",
        "type": "Date",
        "textResourceBindings": {
          "title": "Godkjenningsdato",
          "description": "Settes når saken ble godkjent"
        },
        "value": "2026-07-20",
        "format": "dd.MM.yyyy"
      },
      {
        "id": "DatePage-Divider-InGrid",
        "type": "Divider"
      },

      {
        "id": "DatePage-H-InGroup",
        "type": "Heading",
        "size": "h3",
        "textResourceBindings": {
          "title": "Inne i en repeterende gruppe"
        }
      },
      {
        "id": "DatePage-InGroup-Info",
        "type": "Paragraph",
        "textResourceBindings": {
          "title": "Legg til en rad for å se Dato vist i en tabell for repeterende gruppe. Gruppen bruker redigeringsmodus onlyTable, slik at Dato beholder ledeteksten inne i cellen."
        }
      },
      {
        "id": "DatePage-Group",
        "type": "RepeatingGroup",
        "dataModelBindings": {
          "group": "repeatingGroup"
        },
        "edit": {
          "mode": "onlyTable"
        },
        "children": ["DatePage-Group-Name", "DatePage-Group-Date"]
      },
      {
        "id": "DatePage-Group-Name",
        "type": "Input",
        "textResourceBindings": {
          "title": "Navn"
        },
        "dataModelBindings": {
          "simpleBinding": "repeatingGroup.name"
        }
      },
      {
        "id": "DatePage-Group-Date",
        "type": "Date",
        "textResourceBindings": {
          "title": "Registreringsdato"
        },
        "direction": "vertical",
        "value": "2026-07-20",
        "format": "dd.MM.yyyy"
      },
      {
        "id": "Date-NavigationButtons",
        "type": "NavigationButtons",
        "textResourceBindings": {}
      }
