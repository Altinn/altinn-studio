        "format": "dd.MM.yyyy"
      },
      {
        "id": "DatePage-Vertical",
        "type": "Date",
        "textResourceBindings": {
          "title": "Dato med vertikal retning"
        },
        "direction": "vertical",
        "value": "2026-07-20",
        "format": "dd.MM.yyyy"
      },
