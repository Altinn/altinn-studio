{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>Altinn/renovate-config",
    ":prHourlyLimit4",
    "customManagers:makefileVersions",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the shared Gitea version ARG using published rootless Docker tags",
      "managerFilePatterns": ["/^src/gitea/Dockerfile$/"],
      "matchStrings": [
        "(?:^|\\r?\\n)ARG GITEA_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)(?:\\r?\\n|$)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "docker.io/gitea/gitea",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)-rootless$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "//\\.github/workflows/app-frontend-k6-browser\\.yml$//"
      ],
      "matchStrings": ["grafana/k6:(?<currentValue>[\\w.-]+)-with-browser"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "grafana/k6",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "grafana/k6:{{{newValue}}}-with-browser"
    },
    {
      "customType": "regex",
      "description": "Track the Rust toolchain copies that cannot read rust-toolchain.toml: image build ARGs, the workspace rust-version and the cargo-deny container",
      "managerFilePatterns": [
        "/^Cargo\\.toml$/",
        "/(^|/)Dockerfile$/",
        "/^\\.github/workflows/rust-dependency-checks\\.yaml$/"
      ],
      "matchStrings": [
        "ARG RUST_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "rust-version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "rust-version: '(?<currentValue>\\d+\\.\\d+\\.\\d+)'"
      ],
      "datasourceTemplate": "rust-version",
      "depNameTemplate": "rust"
    },
    {
      "customType": "regex",
      "description": "Track the Go toolchain copies that cannot read go.mod: the Go releases the runner and Agent images install",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG GO_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go"
    }
  ],
  "separateMultipleMajor": true,
  "postUpdateOptions": ["gomodTidy"],
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Work around renovatebot/renovate#45236: digest updates carry no branch-stage release timestamp, so the stability check would stay pending forever. The lookup-stage minimumReleaseAge check still holds too-new digests back.",
      "matchUpdateTypes": ["digest", "pinDigest", "lockFileMaintenance"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "matchManagers": ["gomod", "pep621"],
      "groupName": "{{manager}} non-major dependencies",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupSlug": "{{manager}}-minor-patch"
    },
    {
      "description": "Require explicit approval for Helm Go dependency updates because even patch releases can change Kubernetes client minor versions",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["helm.sh/helm/v3"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group Kubernetes, Flux, and cluster tooling Go dependency patches so related release trains move together",
      "matchManagers": ["gomod", "custom.regex"],
      "matchPackageNames": [
        "/^k8s\\.io\\//",
        "/^sigs\\.k8s\\.io\\/(controller-runtime|controller-tools|gateway-api|kind)$/",
        "/^sigs\\.k8s\\.io\\/(kustomize|structured-merge-diff)\\//",
        "/^github\\.com\\/fluxcd\\/(flux2\\/v2|.*-controller\\/api|pkg\\/.*)$/"
      ],
      "matchUpdateTypes": ["patch"],
      "groupName": "Kubernetes, Flux, and cluster tooling Go dependency patches",
      "groupSlug": "k8s-flux-runtime-go-patches"
    },
    {
      "description": "Require explicit approval for Kubernetes, Flux, and cluster tooling Go dependency minor/major updates after checking target cluster compatibility",
      "matchManagers": ["gomod", "custom.regex"],
      "matchPackageNames": [
        "/^k8s\\.io\\//",
        "/^sigs\\.k8s\\.io\\/(controller-runtime|controller-tools|gateway-api|kind)$/",
        "/^sigs\\.k8s\\.io\\/(kustomize|structured-merge-diff)\\//",
        "/^github\\.com\\/fluxcd\\/(flux2\\/v2|.*-controller\\/api|pkg\\/.*)$/"
      ],
      "matchUpdateTypes": ["minor", "major"],
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "LibGit2Sharp dependency",
      "groupSlug": "LibGit2Sharp",
      "matchPackageNames": ["LibGit2Sharp"]
    },
    {
      "description": "Let the custom manager update GITEA_VERSION without rewriting the ARG-based FROM instructions",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["src/gitea/Dockerfile"],
      "matchPackageNames": ["docker.io/gitea/gitea"],
      "enabled": false
    },
    {
      "description": "Keep Gitea server updates in their own PR",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["docker.io/gitea/gitea"],
      "groupName": "gitea dependency",
      "groupSlug": "gitea",
      "pinDigests": false
    },
    {
      "description": "Keep Gitea runner image updates together, including digests for the rolling runner base image",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["src/ci/gitea-runner/Dockerfile"],
      "matchPackageNames": ["docker.io/gitea/runner", "docker.io/gitea/runner-images"],
      "groupName": "gitea runner dependencies",
      "groupSlug": "gitea-runner",
      "pinDigests": true
    },
    {
      "description": "Read the Gitea runner base image tag as an Ubuntu release (ubuntu-24.04). Docker versioning treats it as unversioned and would only ever move its digest, so a newer Ubuntu release would never be offered",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["src/ci/gitea-runner/Dockerfile"],
      "matchPackageNames": ["docker.io/gitea/runner-images"],
      "versioning": "regex:^ubuntu-(?<major>\\d+)\\.(?<minor>\\d+)$"
    },
    {
      "description": "Moving service owners' Gitea Actions jobs to a new Ubuntu release is a deliberate choice: give it its own PR, named after the new tag, and create it only after approval on the Dependency Dashboard",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["src/ci/gitea-runner/Dockerfile"],
      "matchPackageNames": ["docker.io/gitea/runner-images"],
      "matchUpdateTypes": ["major", "minor"],
      "groupSlug": "gitea-runner-ubuntu",
      "commitMessageTopic": "Gitea runner base image",
      "commitMessageExtra": "to {{{newValue}}}",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Only update nginx Docker images to stable release lines because installed nginx.org modules come from the stable package repository",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["nginx", "docker.io/library/nginx"],
      "allowedVersions": "/^\\d+\\.(?:\\d*[02468])\\./"
    },
    {
      "description": "Keep the version-pinned .NET images of kubernetes-wrapper and localtest on the latest patch. Docker versioning reads -alpine3.23 as a compatibility suffix and never leaves it, but new .NET patches ship only for the newest Alpine, so read the Alpine release as part of the version. MCR publishes no release timestamps, so minimumReleaseAge would hold these updates pending forever",
      "matchManagers": ["dockerfile"],
      "matchFileNames": [
        "src/Runtime/kubernetes-wrapper/src/Dockerfile",
        "src/Runtime/localtest/Dockerfile"
      ],
      "matchPackageNames": ["mcr.microsoft.com/dotnet/aspnet", "mcr.microsoft.com/dotnet/sdk"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-alpine(?<build>\\d+)\\.(?<revision>\\d+)$",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Move uv in the Studio Assistant CI and image, and .python-version, in one PR. uv installs the Python in .python-version, so uv must know that Python release",
      "matchFileNames": [
        ".github/workflows/altinity-build-test.yaml",
        ".github/workflows/assistant-evals.yaml",
        ".github/workflows/assistant-prompts.yaml",
        "src/AI/assistant/dockerfile",
        "src/AI/assistant/.python-version"
      ],
      "matchPackageNames": ["astral-sh/uv", "ghcr.io/astral-sh/uv", "python"],
      "groupName": "Studio Assistant uv and Python",
      "groupSlug": "assistant-uv-python"
    },
    {
      "matchFileNames": ["src/Designer/**"],
      "matchPackageNames": ["/^@digdir\\/designsystemet-/"],
      "groupName": "Design system in Designer"
    },
    {
      "matchFileNames": ["src/App/**", "src/common/ts/**"],
      "additionalBranchPrefix": "app/",
      "commitMessageSuffix": " (app)",
      "separateMinorPatch": true
    },
    {
      "description": "Keep App Designsystemet updates together and separate from other dependency updates",
      "matchManagers": ["npm"],
      "matchFileNames": ["src/App/frontend/**", "src/common/ts/**"],
      "matchPackageNames": ["/^@digdir\\/designsystemet-/"],
      "groupName": "Design system in App"
    },
    {
      "description": "Skip @percy/cypress 3.1.9: it depends on a beta @percy/sdk-utils (1.32.3-beta.1) whose waitForReady DOM-readiness step hangs, timing out all Cypress Percy snapshots. Allow again once a fixed release (>3.1.9) ships.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@percy/cypress"],
      "allowedVersions": "<3.1.9 || >3.1.9"
    },
    {
      "description": "Automerge non-major Altinn app template package updates (v8)",
      "matchManagers": ["nuget"],
      "matchFileNames": ["src/App/template/v8/src/App/App.csproj"],
      "matchPackageNames": ["Altinn.App.Api", "Altinn.App.Core"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Altinn app template NuGet packages (v8)",
      "groupSlug": "app-template-nuget-v8",
      "addLabels": ["approve"],
      "automerge": true
    },
    {
      "description": "Automerge non-major Altinn app template package updates (v9). Separate from v8 so the two templates never share a PR.",
      "matchManagers": ["nuget"],
      "matchFileNames": ["src/App/template/v9/src/App/App.csproj"],
      "matchPackageNames": ["Altinn.App.Api", "Altinn.App.Core"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Altinn app template NuGet packages (v9)",
      "groupSlug": "app-template-nuget-v9",
      "addLabels": ["approve"],
      "automerge": true
    },
    {
      "description": "Keep the v8 app template's .NET SDK on 8.x: it targets net8.0 and its Dockerfile builds with the 8.0 SDK image",
      "matchManagers": ["nuget"],
      "matchFileNames": ["src/App/template/v8/global.json"],
      "matchPackageNames": ["dotnet-sdk"],
      "allowedVersions": "<9"
    },
    {
      "description": "Automerge agentctl base image updates into the Agent images: the base carries the harness versions agentctl is tested with and is tested where it is built, and the image build, agent-image-check and smoke test gate the update",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["agents/Dockerfile"],
      "matchPackageNames": ["ghcr.io/digdir/agentctl-base"],
      "matchUpdateTypes": ["digest"],
      "addLabels": ["approve"],
      "automerge": true
    },
    {
      "description": "agentctl and agentd in the desktop Agent image follow agentctl's releases, which are semver previews such as v0.1.0-preview.13; Docker versioning would read the preview as a compatibility suffix and never update it",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["agents/Dockerfile"],
      "matchPackageNames": ["ghcr.io/digdir/agentctl"],
      "versioning": "semver",
      "ignoreUnstable": false
    },
    {
      "matchFileNames": ["src/Runtime/localtest/**"],
      "additionalBranchPrefix": "localtest/",
      "commitMessageSuffix": " (localtest)"
    },
    {
      "description": "Keep Go module updates in repository-wide groups",
      "matchManagers": ["gomod"],
      "additionalBranchPrefix": "",
      "commitMessageSuffix": ""
    },
    {
      "matchFileNames": ["src/App/**"],
      "matchPackageNames": [
        "/dotnet(-|\\/)sdk/",
        "/^Microsoft\\.AspNetCore/",
        "/^Microsoft\\.Extensions/",
        "!Microsoft.Extensions.Caching.Hybrid"
      ],
      "allowedVersions": "<=8"
    },
    {
      "matchFileNames": ["src/App/**"],
      "matchPackageNames": [
        "/^Microsoft\\.CodeAnalysis/",
        "/^Microsoft\\.Build/"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Quartz upgrades need a hand-written QuartzTables migration and a tables-file update in designer-backend-check-quartz-update.yml, so keep them out of the shared nuget group",
      "matchManagers": ["nuget"],
      "matchFileNames": ["src/Designer/backend/**"],
      "matchPackageNames": ["/^Quartz/"],
      "groupName": "Quartz packages in Designer",
      "groupSlug": "designer-quartz",
      "dependencyDashboardApproval": true
    },
    {
      "description": "MSBuild packages must ship assets for studioctl-server's target framework; a separate PR keeps a mismatch from blocking the shared nuget group",
      "matchManagers": ["nuget"],
      "matchFileNames": ["src/cli/**"],
      "matchPackageNames": ["/^Microsoft\\.Build/", "Microsoft.NET.StringTools"],
      "groupName": "MSBuild packages in studioctl",
      "groupSlug": "studioctl-msbuild"
    },
    {
      "matchFileNames": [
        "src/App/codelists/**",
        "src/App/fileanalyzers/**",
        "src/Designer/backend/**"
      ],
      "ignoreDeps": ["Altinn.App.Core"]
    },
    {
      "matchFileNames": ["src/Designer/backend/**"],
      "ignoreDeps": ["Moq"]
    },
    {
      "matchFileNames": [
        "src/Altinn.Platform/**",
        "src/test/**",
        "src/Runtime/localtest/**",
        "src/App/backend/**",
        "src/App/fileanalyzers/**",
        "src/App/codelists/**"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Upgrade React consistently across the entire repository",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "React ecosystem",
      "groupSlug": "react-ecosystem",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": ""
    },
    {
      "description": "Manage all Rust dependencies manually",
      "matchManagers": ["cargo"],
      "enabled": false
    },
    {
      "description": "Move rust-toolchain.toml, every copy of its version and the rust build image in one pull request, so CI, the runner images and the Agent images build with the toolchain the checkout selects.",
      "matchDatasources": ["rust-version", "docker"],
      "matchPackageNames": ["rust", "docker.io/library/rust"],
      "groupName": "Rust toolchain",
      "groupSlug": "rust-toolchain",
      "enabled": true
    },
    {
      "description": "Move the go.mod go directives, every copy of their version and the golang build images in one pull request, so CI, the shipped binaries, the runner images and the Agent images build with the Go release the modules declare. Renovate treats the go directive as a minimum and leaves it alone unless rangeStrategy is bump. Patch releases get their own pull request, so security fixes are not held back while a minor release waits for approval.",
      "matchDatasources": ["golang-version", "docker"],
      "matchPackageNames": ["go", "golang", "docker.io/library/golang"],
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain",
      "rangeStrategy": "bump",
      "separateMinorPatch": true
    },
    {
      "description": "Refresh the golang image digests in the patch pull request, so they are not held back while a Go minor release waits for approval",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang", "docker.io/library/golang"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "groupSlug": "patch-go-toolchain"
    },
    {
      "description": "Require approval for new Go minor releases: raising the go directive changes the language version and the GODEBUG defaults the modules run with, and golangci-lint must support the release first.",
      "matchDatasources": ["golang-version", "docker"],
      "matchPackageNames": ["go", "golang", "docker.io/library/golang"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Let the go directives and GO_VERSION arguments wait longer than the golang images, which are published a day or two after a Go release, so a Go toolchain pull request does not pair a new go directive with the previous image and fail to build under the images' GOTOOLCHAIN=local",
      "matchDatasources": ["golang-version"],
      "matchPackageNames": ["go"],
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Move the golangci-lint every Go module's Makefile installs in one pull request, so the modules lint with the same release",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["github.com/golangci/golangci-lint/v2"],
      "groupName": "golangci-lint",
      "groupSlug": "golangci-lint"
    }
  ],
  "schedule": ["* 7-15 * * 1-5"],
  "updateNotScheduled": false,
  "automergeSchedule": ["* 7-15 * * 1-5"],
  "platformAutomerge": false
}
