[Unit]
Description=OpenSSH server for Agent access on the guest loopback
Documentation=https://github.com/Altinn/altinn-studio/tree/main/src/experimental
# agentd writes the host key when the Agent declares SSH access; without it sshd never starts.
ConditionPathExists=/var/lib/agent/ssh/ssh_host_ed25519_key
After=network.target

[Service]
ExecStartPre=/usr/sbin/sshd -t -f /etc/agent/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /etc/agent/sshd_config
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartPreventExitStatus=255

[Install]
WantedBy=multi-user.target
