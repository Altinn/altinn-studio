<?xml version="1.0" encoding="UTF-8"?>
<!--
  Deterministic window placement for an agent-driven desktop: one desktop, no animations, and
  every window maximized, so a screenshot taken now and one taken after a restart put the same
  interface at the same coordinates. System-wide rather than under the Agent's home directory,
  which the platform resynchronizes from the host on every Sandbox setup.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance>
    <strength>0</strength>
    <screen_edge_strength>0</screen_edge_strength>
  </resistance>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <raiseOnFocus>yes</raiseOnFocus>
  </focus>
  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>
  <theme>
    <name>Clearlooks</name>
    <titleLayout>LIMC</titleLayout>
    <keepBorder>no</keepBorder>
    <animateIconify>no</animateIconify>
  </theme>
  <desktops>
    <number>1</number>
    <names><name>desktop</name></names>
    <popupTime>0</popupTime>
  </desktops>
  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Never</popupShow>
  </resize>
  <keyboard>
    <!-- The usual shortcut for a terminal, for a person who takes over the desktop. -->
    <keybind key="C-A-t">
      <action name="Execute"><command>desktop-terminal</command></action>
    </keybind>
  </keyboard>
  <applications>
    <application class="*">
      <maximized>yes</maximized>
    </application>
  </applications>
</openbox_config>
