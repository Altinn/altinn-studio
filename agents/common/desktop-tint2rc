# A panel that says what is open and what time it is, and nothing else. Pinned rather than left to
# the distribution default so the taskbar occupies the same 30 pixels of every screenshot, and
# passed to tint2 with -c so it is read from here rather than copied into a home directory the
# platform resynchronizes from the host on every Sandbox setup.

# Every background an item refers to must be defined, in order: tint2 segfaults on a background id
# it cannot resolve.
rounded = 0
border_width = 0
background_color = #1a1a1a 100
border_color = #1a1a1a 100

rounded = 0
border_width = 0
background_color = #3a3a3a 100
border_color = #5a5a5a 100

panel_items = TC
panel_size = 100% 30
panel_position = bottom center horizontal
panel_background_id = 1
panel_margin = 0 0
panel_padding = 4 0 4
panel_layer = top
strut_policy = follow_size
autohide = 0

taskbar_mode = single_desktop
taskbar_padding = 0 0 4
task_maximum_size = 260 24
task_padding = 6 2 6
task_text = 1
task_icon = 1
task_font_color = #d0d0d0 100
task_active_background_id = 2
task_active_font_color = #ffffff 100

time1_format = %H:%M
time2_format = %A %-d %B
clock_font_color = #ffffff 100
clock_padding = 8 0
