[Unit]
Description=D-Bus session bus for the Agent desktop
Documentation=https://github.com/Altinn/altinn-studio/tree/main/agents
# The runtime directory is created by tmpfiles, and the bus has to exist before the desktop's
# programs start so that they register with the accessibility bus it activates.
After=systemd-tmpfiles-setup.service
Before=agent-desktop-session.service

[Service]
# A Session is a tmux process rather than a login, so no systemd user instance or login session
# provides this bus. The address is fixed and the image sets DBUS_SESSION_BUS_ADDRESS to it, so
# every Session and every program on the desktop finds the same bus. at-spi2-core is started on
# it by D-Bus activation the first time an application or `desktop tree` asks for it.
Type=exec
User=agent
Group=agent
Environment=HOME=/home/agent
ExecStart=/usr/bin/dbus-daemon --session --address=unix:path=/run/user/1000/bus --nofork --nopidfile --syslog-only
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
