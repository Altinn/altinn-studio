#!/bin/sh
set -eu

# Git invokes helpers for get, store and erase. The PAT stays represented by its inert
# environment placeholder here; network mediation replaces it only in Basic authentication
# sent to an allowed Azure DevOps host.
if [ "${1:-}" != get ] || [ -z "${AZURE_DEVOPS_PAT:-}" ]; then
    exit 0
fi

printf 'username=agent\npassword=%s\n' "$AZURE_DEVOPS_PAT"
