#!/bin/sh
# The desktop's browser is the one Chromium the image already carries for Playwright, so a page
# looks the same whether playwright-cli or a person opened it.
#
# The flags are the ones measured to matter in an Agent Sandbox. --disable-gpu and
# --use-gl=swiftshader are deliberately absent: neither changed launch time, page load or scroll
# latency against software rendering here, and each is one more way for the browser to differ
# from the one Playwright drives. --disable-dev-shm-usage keeps Chromium's shared memory in /tmp,
# which the desktop Agent sizes, rather than in a /dev/shm whose size the Sandbox owns.
# --force-renderer-accessibility fills in the page's accessibility tree, which `desktop tree`
# reads; without it Chromium exposes only its window frames.
set -eu

# The Agent's CA bundle is imported into Chromium in the background after boot, and a browser
# started before that finishes reports certificate errors for mediated hosts. Wait a short while
# for the import's marker, then start regardless: an untrusted page is better than no browser.
ready=${AGENT_BROWSER_CA_READY_FILE:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/chromium-ca-ready}
if [ ! -e "$ready" ]; then
    echo "chromium: waiting for the Agent CA bundle to be imported" >&2
    attempts=0
    while [ ! -e "$ready" ] && [ "$attempts" -lt 600 ]; do
        sleep 0.1
        attempts=$((attempts + 1))
    done
    [ -e "$ready" ] || echo "chromium: the CA import has not finished; certificate errors may follow" >&2
fi

for candidate in /opt/ms-playwright/chromium-*/chrome-linux*/chrome; do
    [ -x "$candidate" ] && exec "$candidate" \
        --no-first-run \
        --no-default-browser-check \
        --password-store=basic \
        --disable-infobars \
        --disable-dev-shm-usage \
        --force-renderer-accessibility \
        "$@"
done
echo "chromium: no Playwright Chromium build found under /opt/ms-playwright" >&2
exit 1
